{
  "name": "klartext",
  "version": "1.5.0",
  "description": "Klartext — Fast, local-first, multi-root & multi-repo Markdown editor with Technical Nordic design, interactive Mermaid & Visual Diagram Builder, and optional local AI",
  "main": "./out/main/index.js",
  "author": "Johan Zetterström & Klartext Contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:unit": "vitest run src/tests/unit src/tests/security",
    "test:integration": "vitest run src/tests/integration",
    "test:e2e": "playwright test",
    "package": "rm -rf dist && electron-vite build && electron-builder --dir",
    "release:mac": "bash scripts/release.sh"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/language-data": "^6.5.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.34.0",
    "@lezer/common": "^1.2.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/markdown": "^1.3.0",
    "@untitledui/icons": "^0.0.23",
    "chokidar": "^4.0.0",
    "dompurify": "^3.1.7",
    "katex": "^0.18.10",
    "lucide-react": "^0.454.0",
    "mermaid": "^11.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "remark-stringify": "^11.0.0",
    "simple-git": "^4.0.2",
    "unified": "^11.0.5",
    "yaml": "^2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/dompurify": "^3.2.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.8.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "katex": "$katex"
  }
}
